# This repository is intentionally a thin wrapper around a local SRIM-2013
# installation. Keep automation/configuration files only; exclude SRIM itself
# and generated run artifacts.
*

!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTING.md
!/docs/
!/docs/cygno_srim_methodology.md
!/GasDensities.csv
!/srim_gas_sweep.py
!/trim_qf_sweep.py
!/srim_scan.py
!/pysrim_runner.py
!/fix_srim_no_admin.ps1
!/fix_srim_no_admin.bat
!/scan.bat
!/srim-root.txt
!/configs/
!/configs/*.toml
!/examples/
!/examples/*.csv
!/tests/
!/tests/*.py
!/scripts/
!/scripts/*.sh
!/scripts/*.py
!/scripts/start_cygno_study.ps1
!/scripts/control_cygno_study.ps1

# Generated scan state and local Python caches remain untracked.
runs/
__pycache__/
*.pyc
.venv/
.pytest_cache/
